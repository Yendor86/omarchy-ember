#!/usr/bin/env bash
# ember — tell the desktop presence what's happening.
#   ember thinking   ember speaking   ember listening   ember alert   ember idle
#   ember status     -> prints current state
set -euo pipefail
dir="${XDG_RUNTIME_DIR:-/tmp}/ember"
mkdir -p "$dir"
state="${1:-idle}"
case "$state" in
  idle|listening|thinking|speaking|alert)
    printf '%s\n' "$state" > "$dir/state" ;;
  status)
    cat "$dir/state" 2>/dev/null || echo idle ;;
  -h|--help|help)
    grep '^#' "$0" | sed 's/^# \{0,1\}//' ; exit 0 ;;
  *)
    echo "ember: unknown state '$state'" >&2
    echo "try: idle | listening | thinking | speaking | alert | status" >&2
    exit 1 ;;
esac
